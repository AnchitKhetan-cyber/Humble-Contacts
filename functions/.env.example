# SMTP credentials for nodemailer (used by requestAccountDeletion).
# Copy to functions/.env (git-ignored) or set as Firebase secrets, then deploy.
# Example values shown for SendGrid; any SMTP provider works.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
SMTP_FROM=Humble Contacts <no-reply@yourdomain.com>
