<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent placeholder used as the system cold-start splash icon.
     Android 12+ always draws a splash window before the app can render; supplying
     a transparent icon (instead of the launcher icon) makes that window show only
     the themed background colour, so it blends invisibly into AnimatedSplashScreen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
