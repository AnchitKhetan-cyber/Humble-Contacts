<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HumbleContacts" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FF0F1523</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Cold-start system splash (dark). Background follows the theme and the app
         logo is shown, matching the rest of the app. -->
    <style name="Theme.HumbleContacts.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0F1523</item>
        <!-- Transparent icon so the OS-enforced cold-start splash shows only the
             background colour (no icon), blending straight into AnimatedSplashScreen. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.HumbleContacts</item>
    </style>
</resources>
